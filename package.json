{
    "name": "Tyr",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "clean": "node -e \"for (const d of ['dist','.test-build']) require('fs').rmSync(d,{recursive:true,force:true})\"",
        "build": "tsc",
        "build:test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
        "test": "npm run build:test && node --test \".test-build/tests/**/*.test.js\"",
        "test:ci": "npm run build:test && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/github-annotations-reporter.mjs --test-reporter-destination=stdout \".test-build/tests/**/*.test.js\"",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "bin": {
        "tyr": "dist/cli/index.js"
    },
    "keywords": [
        "cli",
        "npmtool"
    ],
    "type": "module",
    "author": "Ayaan Khan",
    "license": "MIT",
    "dependencies": {
        "@anthropic-ai/sdk": "^1.9.0",
        "commander": "^10.0.1",
        "figlet": "^1.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0"
    }
}
