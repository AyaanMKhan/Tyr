{
    "printWidth": 160,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "auto",
    "overrides": [
        {
            "files": ["*.json", "*.yml", "*.yaml", "*.md", "*.mdx"],
            "options": { "printWidth": 100 }
        }
    ]
}
